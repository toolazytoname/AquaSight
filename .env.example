# Bark device key. Never commit the real value.
BARK_KEY=
# Optional self-hosted Bark server. Empty = official https://api.day.app
BARK_BASE_URL=

# Optional model key for Chinese enrichment. Leave empty to degrade.
# BYOK through the user's outer LiteLLM gateway. Never commit the real key.
XAI_API_KEY=
XAI_BASE_URL=https://litellm.weichao.site/v1
XAI_MODEL=free
# USD per million tokens. Custom models pause paid processing until both rates are valid.
XAI_USD_PER_MTOK_IN=0
XAI_USD_PER_MTOK_OUT=0
# 0 disables the app's daily candidate gate; provider limits still apply.
# Blank defaults to unlimited for explicit zero token rates, otherwise 100.
MODEL_DAILY_CANDIDATE_CAP=0
# Output budget includes reasoning on some free providers.
MODEL_MAX_OUTPUT_TOKENS=2400

# Optional local API token. Empty = local-only, no auth.
AUTH_TOKEN=

# GitHub Actions ingest into Cloudflare Worker.
INGEST_TOKEN=
INGEST_URL=
API_BASE_URL=

# Cloudflare Access. Email header alone is not trusted; JWT must verify.
ACCESS_EMAIL=
ACCESS_TEAM=
ACCESS_AUD=

# Optional X API bearer. Without it, X auto-subscribe stays disconnected.
X_BEARER_TOKEN=

# Site URL used in digest Bark payload.
SITE_URL=https://example.pages.dev

# otp = email codes. off = local/dev without login.
AUTH_MODE=otp
MAIL_DRIVER=log
MAIL_API_KEY=
MAIL_FROM=鸭先知 <noreply@example.com>
LEGACY_OWNER_EMAIL=
