{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AquaSightEvents",
  "type": "object",
  "required": ["updatedAt", "items", "sourceErrors"],
  "properties": {
    "updatedAt": { "type": "string" },
    "sourceErrors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "message"],
        "properties": {
          "source": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "source", "level", "reason"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "titleZh": { "type": "string" },
          "url": { "type": "string" },
          "source": { "type": "string" },
          "level": { "enum": ["breaking", "normal"] },
          "reason": { "type": "string" },
          "score": { "type": "number" },
          "summary": { "type": "string" },
          "summaryZh": { "type": "string" },
          "memberIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": { "type": "string" },
                "url": { "type": "string" },
                "title": { "type": "string" }
              }
            }
          },
          "publishedAt": { "type": "string" },
          "seenAt": { "type": "string" }
        }
      }
    }
  }
}
